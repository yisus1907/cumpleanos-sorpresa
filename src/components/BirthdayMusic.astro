---
const base = import.meta.env.BASE_URL;
---
<audio id="cancionCumple" loop>

  <source src={`${base}musica/hasta-donde-te-quiero.mp3`} type="audio/mp3">

</audio>


<script>

const audio =
document.getElementById("cancionCumple");



window.iniciarCancion = ()=>{

  if(audio){
    
    audio.play();

  }

}


</script>