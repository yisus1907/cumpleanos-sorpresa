---
const base = import.meta.env.BASE_URL;
---
<audio id="musicaInicio" loop>
  <source src="/cumpleanos-sorpresa/musica/inicio.mp3" type="audio/mp3">
</audio>

<script>
const audio = document.getElementById(
  "musicaInicio"
) as HTMLAudioElement;


window.addEventListener(
  "iniciarSorpresa",
  () => {

    audio.play();

  }
);

</script>