<section class="galeria">

  <h2>
    Nuestros recuerdos ❤️
  </h2>


  <div class="fotos">

    {
      Array.from({length:25},(_,i)=>(
        <div class="foto">

          <img
          src={`/fotos/foto${String(i+1).padStart(2,"0")}.jpg`}
          alt={`Recuerdo ${i+1}`}
          />

          <p>
            ✨ Recuerdo especial ✨
          </p>

        </div>
      ))
    }

  </div>

</section>


<style>


.galeria{

min-height:100vh;

padding:80px 20px;

background:
linear-gradient(
180deg,
#0f172a,
#312e81
);

text-align:center;

}



h2{

font-family:"Great Vibes",cursive;

font-size:70px;

color:#f9a8d4;

margin-bottom:50px;

}



.fotos{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(250px,1fr));

gap:40px;

max-width:1100px;

margin:auto;

}



.foto{

background:white;

padding:15px;

border-radius:5px;

box-shadow:
0 20px 40px rgba(0,0,0,.4);

transform:
rotate(-3deg);

transition:.5s;

}



.foto:nth-child(even){

transform:
rotate(4deg);

}



.foto:hover{

transform:
scale(1.08)
rotate(0deg);

}



img{

width:100%;

height:280px;

object-fit:cover;

}



.foto p{

color:#831843;

font-family:
"Playfair Display",
serif;

margin-top:15px;

}



</style>